{
  "name": "@anchorlist/svelte",
  "version": "0.0.0",
  "description": "Svelte 5 virtual list with stable scroll anchoring: virtualized chat lists and reverse infinite scroll without scroll jump, infinite feeds and dynamic heights.",
  "keywords": [
    "virtual list",
    "virtualized list",
    "virtual scroll",
    "virtual scroller",
    "windowing",
    "infinite scroll",
    "reverse infinite scroll",
    "chat",
    "chat list",
    "scroll anchoring",
    "dynamic height",
    "variable height",
    "typescript",
    "svelte",
    "svelte5",
    "runes",
    "svelte virtual list",
    "svelte chat",
    "svelte component"
  ],
  "homepage": "https://saranbalaji1408.github.io/anchorlist/",
  "bugs": {
    "url": "https://github.com/saranbalaji1408/anchorlist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranbalaji1408/anchorlist.git",
    "directory": "packages/svelte"
  },
  "license": "MIT",
  "author": "saranbalaji1408",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.size",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && node scripts/compile.js",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@anchorlist/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.18.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6"
  }
}
