{
  "name": "anchorlist",
  "version": "0.0.0",
  "description": "Virtual list for React with stable scroll anchoring: chat lists and reverse infinite scroll without scroll jump, infinite feeds and dynamic heights. Framework-agnostic core, zero dependencies.",
  "keywords": [
    "virtual list",
    "virtualized list",
    "virtual scroll",
    "virtual scroller",
    "virtualization",
    "windowing",
    "infinite scroll",
    "reverse infinite scroll",
    "chat",
    "chat list",
    "scroll anchoring",
    "scroll position",
    "prepend",
    "dynamic height",
    "variable height",
    "react",
    "react virtual list",
    "react chat",
    "typescript"
  ],
  "homepage": "https://saranbalaji1408.github.io/anchorlist/",
  "bugs": {
    "url": "https://github.com/saranbalaji1408/anchorlist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranbalaji1408/anchorlist.git",
    "directory": "packages/anchorlist"
  },
  "license": "UNLICENSED",
  "author": "saranbalaji1408",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anchorlist/core": "workspace:*",
    "@anchorlist/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
