{
  "name": "@anchorlist/core",
  "version": "0.0.0",
  "description": "Framework-agnostic virtual list engine with stable scroll anchoring: windowing, dynamic heights, chat-style reverse infinite scroll, feeds, masonry and grid. Zero dependencies.",
  "keywords": [
    "virtual list",
    "virtualized list",
    "virtual scroll",
    "virtual scroller",
    "windowing",
    "infinite scroll",
    "reverse infinite scroll",
    "chat",
    "chat list",
    "scroll anchoring",
    "dynamic height",
    "variable height",
    "masonry",
    "grid",
    "typescript",
    "headless",
    "framework agnostic"
  ],
  "homepage": "https://saranbalaji1408.github.io/anchorlist/",
  "bugs": {
    "url": "https://github.com/saranbalaji1408/anchorlist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranbalaji1408/anchorlist.git",
    "directory": "packages/core"
  },
  "license": "UNLICENSED",
  "author": "saranbalaji1408",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "cd ../.. && BENCH=1 NODE_OPTIONS=--expose-gc vitest run packages/core/src/engine.perf.test.ts"
  }
}
