{
  "name": "anchorlist-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for anchorlist: a virtual list with stable scroll anchoring for React, Vue and Svelte.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "size-limit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "docs:dev": "pnpm --filter @anchorlist/docs dev",
    "docs:build": "pnpm --filter @anchorlist/docs build",
    "bench": "pnpm --filter @anchorlist/bench bench",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
