{
  "name": "@anchorlist/bench",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Head-to-head benchmark: anchorlist vs @tanstack/react-virtual vs react-virtuoso in a chat list.",
  "scripts": {
    "build": "vite build",
    "bench": "pnpm --dir .. build && vite build && node run.ts",
    "size": "size-limit --json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.14",
    "anchorlist": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "4.18.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "size-limit": "^14.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
